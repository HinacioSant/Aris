<Application x:Class="Aris.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aris"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Colors.xaml"/>
            <ResourceDictionary Source="Themes/Brushes.xaml"/>
            <ResourceDictionary Source="Themes/Fonts.xaml"/>
            <ResourceDictionary Source="Themes/Controls/Button.xaml"/>
            <ResourceDictionary Source="Themes/Controls/Window.xaml"/>
            <ResourceDictionary Source="Themes/Controls/TextBox.xaml"/>
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
</Application.Resources>
</Application>
