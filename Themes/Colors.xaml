<!-- Themes/Colors.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds: layer from darkest to lightest -->
    <Color x:Key="Bg0">#000000</Color>   <!-- app chrome / outermost -->
    <Color x:Key="Bg1">#252526</Color>   <!-- panels, sidebars -->
    <Color x:Key="Bg2">#2D2D30</Color>   <!-- cards, toolbars -->
    <Color x:Key="Bg3">#3E3E42</Color>   <!-- input fields, hover surfaces -->

    <!-- Borders -->
    <Color x:Key="BorderSubtle">#3F3F46</Color>
    <Color x:Key="BorderStrong">#5A5A5D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#39FF14</Color>
    <Color x:Key="TextSecondary">#33a61e</Color>
    <Color x:Key="TextDisabled">#1c5c11</Color>

    <!-- Accent (your brand/action color) -->
    <Color x:Key="Accent">#17fdad</Color>
    <Color x:Key="AccentHover">#6ECFFF</Color>
    <Color x:Key="AccentPressed">#3AA8E6</Color>

    <!-- Base Colors -->
    <Color x:Key="TealBase">#4EC9B0</Color> 
    <Color x:Key="YellowBase">#DCDCAA</Color>
    <Color x:Key="RedBase">#F14C4C</Color>
    <Color x:Key="BlueBase">#569CD6</Color>

</ResourceDictionary>