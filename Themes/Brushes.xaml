<!-- Themes/Brushes.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/> <!-- Black bg [Main Color] -->
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/> <!-- Variation as it goes -->
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/> <!-- Grey -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/> <!-- Green -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/> <!-- Hover Green -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>

    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealBase}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowBase}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedBase}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueBase}"/>

</ResourceDictionary>