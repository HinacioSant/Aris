<UserControl  x:Class="Aris.Pages.Viewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"       
        mc:Ignorable="d">
    <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="40"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>   <!-- pdf viewer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="← Back" Click="Go_back" Width="80" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">            
            <ComboBox x:Name="PageSelector" 
                    Width="80"
                    VerticalAlignment="Center"
                    SelectionChanged="Page_selector"/> 
                               
            <TextBlock x:Name="PageLabel" Text="of 1" 
                    VerticalAlignment="Center" Margin="5"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">                
                <Button Content="Changes-Toggle" Click="Apply_Changes" Width="85"/> <!-- Change to toggle -->
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- pdf viewer -->
                <ColumnDefinition Width="2"/>   <!-- splitter -->
                <ColumnDefinition Width="2"/>   <!-- overlay panel -->
            </Grid.ColumnDefinitions>               
        </Grid>

        <Grid Grid.Row = "2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="col_0" Width="auto"/>  <!-- pdf viewer -->
                <ColumnDefinition Width="2"/>   <!-- splitter -->
                <ColumnDefinition x:Name="col_2" Width="auto"/>   <!-- overlay panel -->
                <ColumnDefinition Width="*"/>   <!-- overlay panel -->
            </Grid.ColumnDefinitions>  
        
            <Grid Grid.Column="0" x:Name="ViewerGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch" ClipToBounds="True"/>
             <wf:WindowsFormsHost x:Name="PdfHost"/>

            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Left" Background="Black"/>             
                <!-- Canvas on top -->
            
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ClipToBounds="True">
             <Canvas x:Name="WordCanvas" Background="Transparent" ClipToBounds="True" VerticalAlignment="Top"/>
            </ScrollViewer>

            
            <StackPanel Grid.Column="3" x:Name="ChangesPanel" Background="WhiteSmoke">
                <TextBlock Text="Pending Changes" FontWeight="Bold" Margin="5"/>


                <ListView x:Name="ChangesList" Margin="10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>   <!-- change info -->
                                    <ColumnDefinition Width="60"/>  <!-- undo button -->
                                </Grid.ColumnDefinitions>

                             <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Original}" Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,8,0"/>
                                <TextBlock Text="→" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding New}" Foreground="Green"/>
                                <TextBlock Text="{Binding Position}" Foreground="Gray" Margin="8,0,0,0" FontSize="10"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Undo" Tag="{Binding tag_pos}" Click="Undo_Click" Width="50" Height="22"/>
                             </Grid>
                        </DataTemplate>                        
                    </ListView.ItemTemplate>
                </ListView>
                              
                <Button Content="Apply Changes" Click="Apply_Changes" Width="85" HorizontalAlignment="Center" Margin="5"/>
                        
            </StackPanel>
        </Grid>
        
    
    </Grid>


</UserControl>
