<UserControl  x:Class="Aris.Pages.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" PreviewKeyDown="Page_PreviewKeyDown" Focusable="True" Loaded="UserControl_Loaded">
            
    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">            
            <TextBlock x:Name="HomeText" Margin="0,12,0,7" FontSize="22" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SecondBlock" Margin="0,7,0,7" FontSize="12" HorizontalAlignment="Center"/> 
            <TextBlock x:Name="ThirdBlock" Margin="0,7,0,7" FontSize="12" HorizontalAlignment="Center"/>  
        </StackPanel>
    </Grid>
</UserControl>
